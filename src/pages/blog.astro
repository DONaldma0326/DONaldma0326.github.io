---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Pill from '../components/Pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout title="Blog | Your Name" description="Notes and updates">
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Blog"
				tagline="Short updates, project notes, and learnings. Edit files in src/content/blog to publish."
				align="start"
			/>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`}>
								<div class="stack gap-2">
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</div>
								<div class="meta">
									<span>{post.data.publishDate.toLocaleDateString()}</span>
									<div class="tags">
										{post.data.tags.map((tag) => <Pill>{tag}</Pill>)}
									</div>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.post-card {
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.post-card a {
		display: grid;
		gap: 1rem;
		padding: 1.25rem;
		text-decoration: none;
	}

	h2 {
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	p {
		color: var(--gray-300);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		align-items: center;
		color: var(--gray-400);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
</style>
