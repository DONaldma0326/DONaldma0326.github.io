---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | DONaldMa" description="About me">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="AI and Data Engineer focused on distributed computing, MLOps, and scalable data platforms."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Working session with a teammate"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Focus</h2>
				<div class="content">
					<p>
						My current focus is data and AI architecture design, especially systems that can scale in
						production and stay maintainable over time.
					</p>
					<p>
						I am deep-diving into distributed systems and sharing practical lessons through project
						documentation and technical writing.
					</p>
					<p>
						I write articles sharing insights on engineering practice, skills, and breakdowns of my personal projects.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Tech Stack</h2>
				<div class="content">
					<p><strong>Programming languages:</strong> Python, SQL, Go.</p>
					<p>
						<strong>Data Engineering:</strong> Spark, Databricks, Delta Lake, Airflow, Kafka, and Flink.
					</p>
					<p><strong>AI and Cloud </strong>RAG, AWS, Azure, Terraform, Docker.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Beyond Code</h2>
				<div class="content">
					<p>Basketball and gym enthusiast.</p>
					<p>Always reading and open to sharing knowledge.</p>
					<p><strong>Life motto:</strong> Work hard, play hard.</p>
				</div>
			</section>
		</main>

	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
