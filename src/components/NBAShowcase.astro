---
interface Props {
	img?: string;
}

const { img } = Astro.props;
---

<div class="showcase">
	<div class="metrics-grid">
		<div class="metric-card">
			<span class="metric-value" data-target="40880">0</span>
			<span class="metric-label">Game-Rows Trained</span>
		</div>
		<div class="metric-card">
			<span class="metric-value" data-target="16">0</span>
			<span class="metric-label">NBA Seasons</span>
		</div>
		<div class="metric-card">
			<span class="metric-value" data-target="614">0<span class="decimal">%</span></span>
			<span class="metric-label">Prediction Accuracy</span>
		</div>
		<div class="metric-card">
			<span class="metric-value" data-target="19">0</span>
			<span class="metric-label">Engineered Features</span>
		</div>
		<div class="metric-card">
			<span class="metric-value" data-target="3">0</span>
			<span class="metric-label">Data Layers (Bronze/Silver/Gold)</span>
		</div>
		<div class="metric-card">
			<span class="metric-value" data-target="11">0</span>
			<span class="metric-label">Docker Containers</span>
		</div>
	</div>

	<div class="pipeline">
		<svg viewBox="0 0 900 80" class="pipeline-svg" aria-label="Data pipeline flow">
			<defs>
				<linearGradient id="flow-grad" x1="0" y1="0" x2="1" y2="0">
					<stop offset="0%" stop-color="var(--accent)" />
					<stop offset="100%" stop-color="var(--accent-dark)" />
				</linearGradient>
				<marker id="arrowhead" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
					<polygon points="0 0, 8 3, 0 6" fill="var(--accent)" />
				</marker>
			</defs>
			<g class="pipeline-nodes">
				<rect x="10" y="20" width="120" height="40" rx="8" class="node nba-api" />
				<text x="70" y="45" text-anchor="middle" class="node-label">NBA API</text>

				<rect x="160" y="20" width="100" height="40" rx="8" class="node bronze" />
				<text x="210" y="45" text-anchor="middle" class="node-label">Bronze</text>

				<rect x="290" y="20" width="100" height="40" rx="8" class="node silver" />
				<text x="340" y="45" text-anchor="middle" class="node-label">Silver</text>

				<rect x="420" y="20" width="100" height="40" rx="8" class="node gold" />
				<text x="470" y="45" text-anchor="middle" class="node-label">Gold</text>

				<rect x="550" y="20" width="120" height="40" rx="8" class="node model" />
				<text x="610" y="45" text-anchor="middle" class="node-label">XGBoost</text>

				<rect x="700" y="10" width="90" height="28" rx="6" class="node api" />
				<text x="745" y="28" text-anchor="middle" class="node-label" font-size="11">FastAPI</text>
				<rect x="700" y="42" width="90" height="28" rx="6" class="node dashboard" />
				<text x="745" y="60" text-anchor="middle" class="node-label" font-size="11">Streamlit</text>
			</g>
			<g class="pipeline-arrows">
				<line x1="130" y1="40" x2="155" y2="40" marker-end="url(#arrowhead)" class="arrow" />
				<line x1="260" y1="40" x2="285" y2="40" marker-end="url(#arrowhead)" class="arrow" />
				<line x1="390" y1="40" x2="415" y2="40" marker-end="url(#arrowhead)" class="arrow" />
				<line x1="520" y1="40" x2="545" y2="40" marker-end="url(#arrowhead)" class="arrow" />
				<line x1="670" y1="40" x2="695" y2="25" marker-end="url(#arrowhead)" class="arrow" />
				<line x1="670" y1="40" x2="695" y2="55" marker-end="url(#arrowhead)" class="arrow" />
			</g>
		</svg>
	</div>
</div>

<script>
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const counters = entry.target.querySelectorAll('[data-target]');
					counters.forEach((counter) => {
						const target = parseInt(counter.dataset.target ?? '0');
						const duration = 1500;
						const start = performance.now();

						const update = (now: number) => {
							const elapsed = now - start;
							const progress = Math.min(elapsed / duration, 1);
							const eased = 1 - Math.pow(1 - progress, 3);
							const current = Math.round(eased * target);
							if (counter.dataset.target === '614') {
								const int = Math.floor(eased * target / 10) * 10;
								// keep the decimal % in place, update only the number part
								const textNode = counter.childNodes[0];
								if (textNode) {
									textNode.textContent = String(int / 10).replace(/\.0$/, '');
								}
							} else {
								counter.textContent = String(current);
							}
							if (progress < 1) {
								requestAnimationFrame(update);
							} else {
								if (counter.dataset.target === '614') {
									const textNode = counter.childNodes[0];
									if (textNode) textNode.textContent = '61.4';
								} else {
									counter.textContent = String(target);
								}
							}
						};
						requestAnimationFrame(update);
					});
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.3 },
	);

	const showcase = document.querySelector('.showcase');
	if (showcase) observer.observe(showcase);
</script>

<style>
	.showcase {
		margin: 2rem 0;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.metric-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding: 1.25rem 0.75rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		text-align: center;
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.metric-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.metric-value {
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}

	.decimal {
		font-size: 0.5em;
		vertical-align: super;
		color: var(--gray-400);
	}

	.metric-label {
		font-size: var(--text-sm);
		color: var(--gray-400);
		line-height: 1.2;
	}

	.pipeline {
		padding: 1.5rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		overflow: hidden;
	}

	.pipeline-svg {
		width: 100%;
		height: auto;
	}

	.node {
		fill: var(--gray-800);
		stroke: var(--gray-700);
		stroke-width: 1;
		transition: fill 0.3s;
	}

	.pipeline-svg:hover .node {
		fill: var(--gray-700);
	}

	.node-label {
		fill: var(--gray-200);
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: 12px;
	}

	.arrow {
		stroke: var(--accent);
		stroke-width: 2;
		opacity: 0.6;
	}

	@media (max-width: 50em) {
		.metrics-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 0.75rem;
		}

		.metric-value {
			font-size: var(--text-2xl);
		}
	}
</style>
